digraph train {
  graph [rankdir=TB, fontname="Helvetica", fontsize=22, labelloc=t, nodesep=0.45, ranksep=0.5, newrank=true,
         label="Training path of the x6r flow  (dev/desv_x6r_resume.sh, seed 6; every stage ships its LAST checkpoint)\n\n"];
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=13, penwidth=1.2, fillcolor="#ffffff"];
  edge [fontname="Helvetica", fontsize=11, penwidth=1.3];

  subgraph cluster_sims {
    label="Simulations (../bfd_cnf_imsims, bulgedisc_g2 population, PSF Gaussian σ 0.40\", KBlackmanHarris weight σ 0.65\", 0.2\"/pix)"; fontsize=14; style="rounded,filled"; fillcolor="#f2f2f2"; color="#888888";
    tmpl [label=<<b>Templates</b>  moments_bulgedisc_g2_bdg2d.fits<br/>500,000 galaxies, seed 0, unsheared, recentred<br/>pixel noise 0.611 (sd 0.055 per galaxy) ⇒ σ_f ≈ 61  (DES Y6 deep-field match)<br/>moments M, covariance C, exact bfd dm/dg, d²m/dg²;  rows with J ≤ 0 dropped>];
    copies [label=<<b>Centroid copies</b>  copies_bulgedisc_g2_bdg2d_tn15c.fits<br/>140.7M shifted re-measurements of the 500k templates (each copy carries template noise)<br/>eq.-36 weights L(X | Σ_X) at target noise 2.289 (Σ_X = 273.4² ·I);  exact per-copy dm/dg<br/>cull: 136 templates, 6,902 copies (Mf &lt; 0, Mr &lt; 0 or |e| &gt; 1 in ≥ 1% of a template's copies)>];
  }

  {rank=same; tmpl; copies}
  {rank=same; grid; s4}
  cut [shape=note, style=filled, fillcolor="#fffbe0", label="Template cut (same in every stage)\nMf ≥ 1200  and  Mr/Mf ≥ 1.5\n70.3% of templates selected\nbelow: censored, never fit point-wise"];

  subgraph cluster_s1 {
    label="Stage 1  bulk.py train → bulk_base_x6r.eqx"; fontsize=14; style="rounded,filled"; fillcolor="#e3eefb"; color="#4a7cc0";
    s1 [label=<<b>Censored NLL</b> of the bulk density:<br/>selected template:  log p(m)<br/>censored template:  log P(unselected | C_i) = log(1 − E_p[S(x; C_i)])  (soft selection S from its own covariance)<br/>+ tail_monotone_penalty × 1.0  (|e| marginal falls to 0 before E_MAX = 0.95)<br/>batch 16384, lr 3e-3, EMA 0.9995, --converge (held-out objective)>];
  }
  g1 [shape=diamond, style=filled, fillcolor="#fde2e2", fontsize=11, label="tail gate\nFAIL (4.4e-4 at ceiling)\n→ only its chart\nconstants are used"];

  subgraph cluster_s2 {
    label="Stage 2  bulk.py train --chart-from bulk_base_x6r → bulk_x6r.eqx"; fontsize=14; style="rounded,filled"; fillcolor="#e3eefb"; color="#4a7cc0";
    s2 [label=<chart constants from stage 1, fresh bulk layers<br/><b>Censored NLL</b> + conditioner-Jacobian penalty × 5.0 + tail penalty × 1.0<br/>batch 16384, lr 3e-3, EMA 0.9995;  converged at 50,000 steps>];
  }
  g2 [shape=diamond, style=filled, fillcolor="#e2f5e2", fontsize=11, label="tail gate\nPASS"];

  subgraph cluster_s3 {
    label="Stage 3  shear.py train --init bulk_x6r → shear_x6r.eqx   (bulk frozen)"; fontsize=14; style="rounded,filled"; fillcolor="#e6f5e6"; color="#4f9a4f";
    s3 [label=<<b>Censored NLL of lensed templates</b>: g uniform on the disc |g| ≤ 0.02, antithetic ±g pairs,<br/>each template lensed exactly, m + dm/dg·g + ½ gᵀ(d²m/dg²)g<br/>+ <b>derivative regression</b> × 1e4: the layer's dm/dg, d²m/dg² onto bfd's exact per-template values<br/>+ Jacobian penalty × 5.0 on the flow's own draws below the cut<br/>batch 16384, lr 6e-3, EMA 0.9995;  converged at 60,000 steps>];
  }
  g3 [shape=diamond, style=filled, fillcolor="#e2f5e2", fontsize=11, label="tail gate\nPASS"];

  subgraph cluster_s4 {
    label="Stage 4  centroid.py train-sigmax --init shear_x6r --adapter → centroid_tnc15c_x6r.eqx   (bulk + shear frozen)"; fontsize=14; style="rounded,filled"; fillcolor="#fdf0e0"; color="#c98a2e";
    grid [label=<<b>403 Σ_X training points</b><br/>base Σ_X = 74,724·I  (from the copies)<br/>× (1/1.5)² and × 1.5²  (--multi-scale, --scale-margin 1.5)<br/>400 random anisotropic points, |e_Σ| ≤ 0.10, θ uniform  (--anisotropic --n-aniso 400)>];
    s4 [label=<trained: SigmaXBlockLayer nets + CentroidShearAdapter;  selected templates only<br/><b>z-space shift regression</b>: layer(z_m, Σ_X) − z_m  vs  chart(weighted copy mean at Σ_X) − chart(m),<br/>one MSE per z-slot, each normalised by its own std;  one grid point per step<br/>+ <b>g-response term</b> × 1.0 at every grid point (--g-resp-grid): whole-chain response at g1 = ±0.02<br/>vs chart(J-lensed copy means at ±0.02)<br/>200,000 steps, batch 8192>];
  }
  g4 [shape=diamond, style=filled, fillcolor="#e2f5e2", fontsize=11, label="tail gate PASS\ne-response 0.9966\n(gate 0.97-1.03)\nΣ_X scan max|r−1|\n0.0155 (tol 0.08)"];

  out [shape=box, style="rounded,filled,bold", fillcolor="#f3e6f7", label=<<b>centroid_tnc15c_x6r.eqx</b><br/>p(M | g, Σ_X)  →  shear inference (bias.py)>];

  tmpl -> cut; cut -> s1; s1 -> g1; g1 -> s2 [label=" chart"];
  cut -> s2 [style=dotted]; s2 -> g2; g2 -> s3 [label=" init"];
  cut -> s3 [style=dotted]; s3 -> g3; g3 -> s4 [label=" init"];
  copies -> grid; grid -> s4; cut -> s4 [style=dotted];
  s4 -> g4; g4 -> out;
}
